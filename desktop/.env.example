# Signing and notarization credentials for a release build (`npm run dist`).
# Copy to `.env`, which is gitignored. None of this is needed for `npm start`
# or `npm run pack`, which builds unsigned.

# The Developer ID certificate. Locally, leave these unset: electron-builder
# finds "Michael Lyons (M7Y6TPCQ63)" in the keychain. They are for CI, where
# the certificate arrives as a base64 .p12.
# CSC_LINK=
# CSC_KEY_PASSWORD=

# Notarization. electron-builder notarizes when all three are set and skips it
# silently when they are not, so a build Gatekeeper rejects elsewhere usually
# means one of these is empty. APPLE_APP_SPECIFIC_PASSWORD comes from
# appleid.apple.com > App-Specific Passwords.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
