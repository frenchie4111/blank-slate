{
  "expo": {
    "name": "Blank Slate",
    "slug": "blank-slate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "blank-slate",
    "userInterfaceStyle": "light",
    "jsEngine": "jsc",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "jsEngine": "jsc",
      "bundleIdentifier": "org.mikelyons.blank-slate",
      "appleTeamId": "M7Y6TPCQ63",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Blank Slate lets you pick photos when an app you build asks for one.",
        "NSPhotoLibraryAddUsageDescription": "Blank Slate can save photos when an app you build generates one.",
        "NSMicrophoneUsageDescription": "Blank Slate uses the microphone if an app you build records audio.",
        "NSLocationWhenInUseUsageDescription": "Blank Slate uses your location if an app you build needs it (e.g. weather, check-ins)."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "jsEngine": "jsc",
      "package": "org.mikelyons.blankslate"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Blank Slate needs access to your photos so apps you build can use them.",
          "cameraPermission": "Blank Slate needs access to your camera so apps you build can take photos."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-audio",
      "expo-video",
      "expo-notifications",
      "expo-location",
      "expo-updates"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "9190e865-c3d9-487c-b645-79133647956d"
      }
    },
    "owner": "mikepersonal",
    "updates": {
      "url": "https://u.expo.dev/9190e865-c3d9-487c-b645-79133647956d"
    }
  }
}
